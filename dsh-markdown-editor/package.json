{
  "name": "dsh-markdown-editor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Safe Markdown source assistance and official Markdown message rendering for DSH.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --check lib/client.js && node --check lib/index.js",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build && npm run check"
  },
  "devDependencies": {
    "@lexical/headless": "0.49.0",
    "@lexical/history": "0.49.0",
    "esbuild": "0.25.12",
    "lexical": "0.49.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "docs/",
    "locale/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
  "license": "MIT"
}

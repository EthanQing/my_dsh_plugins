!.env.*.example

# Logs, temporary editor files and OS metadata
*.log
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Intentionally keep plugin lib/, vendor/, package manifests, lockfiles,
